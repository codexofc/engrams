Output "souvenance-demo.gif"
Set Shell "zsh"
Set FontSize 15
Set Width 1240
Set Height 640
Set Padding 18
Set TypingSpeed 40ms
Set Theme "Catppuccin Mocha"
Env HOME "/tmp/vhs-home"
Env PATH "/Users/admin/.cargo/bin:/tmp/vhs-bin:/usr/bin:/bin:/usr/sbin:/sbin"
Env SOUVENANCE_NO_DAEMON "1"
Hide
Type "export PS1='%F{green}❯%f '; clear" Enter
Show
Type "souvenance init" Enter
Sleep 2.5s
Enter
Sleep 2s
Enter
Sleep 2s
Enter
Sleep 3s
Enter
Sleep 2s
Enter
Sleep 2s
Enter
Sleep 6s
Type "clear" Enter
Type 'souvenance search "how do I write a note"' Enter
Sleep 5s
Sleep 1s
